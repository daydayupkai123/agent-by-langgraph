# 复制为 .env 后按需修改；不配置则使用 app/config.py 中的默认值

OLLAMA_BASE_URL=http://localhost:11434

# 主 Agent 模型（需支持 tools；支持 thinking 时可开启 AGENT_REASONING）
AGENT_MODEL=qcwind/qwen3-8b-instruct-Q4-K-M:latest
AGENT_TEMPERATURE=0.6
AGENT_REASONING=true

# Router 意图分类模型，可换成更小更快的模型
ROUTER_MODEL=qcwind/qwen3-8b-instruct-Q4-K-M:latest

# 单次提问内 ReAct 循环的最大轮次
MAX_ITERATIONS=6
